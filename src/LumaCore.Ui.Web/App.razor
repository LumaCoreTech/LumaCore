@using LumaCore.Ui.Web.Pages
@* Root component that defines the routing and authentication context for the entire application. *@

<CascadingAuthenticationState>
	<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(NotFound)">
		<Found Context="routeData">
			<AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
				<NotAuthorized>
					<RedirectToLogin/>
				</NotAuthorized>
			</AuthorizeRouteView>
		</Found>
	</Router>
</CascadingAuthenticationState>
