<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>LumaCore.Api</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<!--
		Include Blazor UI via project reference (default: true).
		Set to false when building the API without UI, e.g. for Docker:
		  dotnet publish /p:IncludeBlazorUi=false
		-->
		<IncludeBlazorUi Condition="'$(IncludeBlazorUi)' == ''">true</IncludeBlazorUi>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\LumaCore.Core\LumaCore.Core.csproj" />
		<ProjectReference Include="..\LumaCore.Ui.Web\LumaCore.Ui.Web.csproj" Condition="'$(IncludeBlazorUi)' == 'true'" />
	</ItemGroup>

	<ItemGroup>
		<!-- ASP.NET Core Packages -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.1" />

		<!-- Native OpenAPI for .NET 10 -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />

		<!-- Swagger UI (visualization only, OpenAPI generation is native) -->
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.0.1" />

		<!-- Serilog packages compatible with .NET 8+ -->
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
		<PackageReference Include="Serilog.Enrichers.Span" Version="3.1.0" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
	</ItemGroup>

</Project>
