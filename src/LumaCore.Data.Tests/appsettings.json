{
  // Database provider for tests. Uncomment ONE provider block below.
  // Environment variables (LUMACORE_TESTS__Db__*) override these settings — CI uses env vars.
  "Db": {
    // --- SQLite in-memory (default) ---
    // Fastest option. No file I/O, no external dependencies.
    "Provider": "sqlitememory"

    // --- SQLite file-based ---
    // Closer to production SQLite behavior (file I/O, locking, journaling).
    // "Provider": "sqlite"

    // --- PostgreSQL ---
    // Requires a running PostgreSQL instance. Connection string must NOT include a database name —
    // each test fixture creates a unique database with a GUID suffix.
    // "Provider": "postgresql",
    // "ConnectionString": "Host=localhost;Port=5432;Username=postgres;Password=postgres"

    // --- SQL Server ---
    // Requires a running SQL Server instance. Same database-naming rules as PostgreSQL.
    // "Provider": "sqlserver",
    // "ConnectionString": "Server=localhost,1433;User Id=sa;Password=YourStrong!Password;TrustServerCertificate=True"

    // --- MySQL / MariaDB (not yet available) ---
    // Pomelo.EntityFrameworkCore.MySql has not yet released an EF Core 10 compatible version.
    // "Provider": "mysql",
    // "ConnectionString": "Server=localhost;Port=3306;User=root;Password=root"
  }
}
