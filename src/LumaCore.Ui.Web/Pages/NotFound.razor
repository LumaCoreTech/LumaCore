@page "/not-found"
@layout MainLayout

@* Simple explicit "not found" page that can be linked to directly.
   The router already has its own NotFound content; this page provides an
   additional, concrete route that can be used from code or links. *@

<h3>@Localizer["pages.notFound.title"]</h3>
<p>@Localizer["pages.notFound.message"]</p>
