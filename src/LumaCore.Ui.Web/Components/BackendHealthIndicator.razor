@using System.Text.Json
@implements IDisposable
@inject HttpClient         Http
@inject BackendHealthState BackendHealth

@* Clickable backend health indicator shown next to the logo in the main layout. *@
<div class="lc-logo-health-indicator"
     @onclick="OnClickAsync"
     title="@GetTooltip()">
	<span class="lc-logo-health-dot @GetDotClass()"></span>
</div>

@code
{
	/// <summary>
	/// Represents the current health state of the backend as observed by this component.
	/// </summary>
	private enum HealthState
	{
		Unknown,
		Checking,
		Ok,
		Error
	}

	/// <summary>
	/// Holds the latest known backend health state; initialized to Unknown before the first probe runs.
	/// </summary>
	private HealthState mState = HealthState.Unknown;

	/// <summary>
	/// Guards against overlapping health checks (e.g., rapid clicks).
	/// </summary>
	private bool mIsChecking;

	/// <summary>
	/// Called by the Blazor framework when the component is first initialized.
	/// Subscribes to health state changes and triggers an initial health check.
	/// </summary>
	protected override Task OnInitializedAsync()
	{
		// Subscribe to passive health updates from API traffic.
		BackendHealth.OnHealthChanged += OnHealthStateChanged;

		// Sync initial state from shared state (may already be set from previous requests).
		mState = BackendHealth.IsHealthy ? HealthState.Ok : HealthState.Error;

		// Perform an active health check to verify the backend is reachable.
		return CheckHealthAsync();
	}

	/// <summary>
	/// Indicates whether the component has been disposed.
	/// </summary>
	private bool mIsDisposed;

	/// <summary>
	/// Handles health state changes from <see cref="BackendHealthState"/>.
	/// </summary>
	private void OnHealthStateChanged()
	{
		// Guard against events firing after disposal.
		if (mIsDisposed)
			return;

		mState = BackendHealth.IsHealthy ? HealthState.Ok : HealthState.Error;
		InvokeAsync(StateHasChanged);
	}

	/// <summary>
	/// Handles click events on the health indicator and re-runs the health check.
	/// </summary>
	private Task OnClickAsync()
	{
		return CheckHealthAsync();
	}

	/// <summary>
	/// Gets the localized tooltip for the current health state.
	/// </summary>
	/// <returns>The translated tooltip text.</returns>
	private string GetTooltip() => mState switch
	{
		HealthState.Ok       => L.Get("components.healthIndicator.tooltips.reachable"),
		HealthState.Error    => L.Get("components.healthIndicator.tooltips.unreachable"),
		HealthState.Checking => L.Get("components.healthIndicator.tooltips.checking"),
		var _                => L.Get("components.healthIndicator.tooltips.unknown")
	};

	/// <summary>
	/// Timeout for health check requests. Short timeout to avoid UI hanging on unresponsive backends.
	/// </summary>
	private static readonly TimeSpan HealthCheckTimeout = TimeSpan.FromSeconds(5);

	/// <summary>
	/// Checks the current health of the backend by calling the live health endpoint.
	/// </summary>
	private async Task CheckHealthAsync()
	{
		// Prevent overlapping checks (e.g., rapid clicks).
		if (mIsChecking)
			return;

		mIsChecking = true;

		// Set state to "Checking" immediately so the UI can show a transitional state.
		mState = HealthState.Checking;
		StateHasChanged();

		try
		{
			// Use a short timeout to avoid hanging on unresponsive backends.
			using var cts = new CancellationTokenSource(HealthCheckTimeout);

			// Perform a lightweight GET request and inspect the status code explicitly.
			using HttpResponseMessage response = await Http
				                                     .GetAsync("api/v1/health/live", HttpCompletionOption.ResponseHeadersRead, cts.Token)
				                                     .ConfigureAwait(true);

			if (!response.IsSuccessStatusCode)
			{
				mState = HealthState.Error;
				return;
			}

			try
			{
				// Attempt to deserialize the JSON payload into the shared API contract.
				ApiHealthLiveResponse? dto = await response.Content
					                             .ReadFromJsonAsync<ApiHealthLiveResponse>(cts.Token)
					                             .ConfigureAwait(true);

				mState = dto is null || string.IsNullOrWhiteSpace(dto.Status)
					         ? HealthState.Error
					         : HealthState.Ok;
			}
			catch (JsonException)
			{
				// Response body was not valid JSON or didn't match expected structure
				mState = HealthState.Error;
			}
		}
		catch (HttpRequestException)
		{
			// Network error — backend unreachable, DNS failure, connection refused, etc.
			mState = HealthState.Error;
		}
		catch
		{
			// Unexpected error — timeout, cancellation, or other unforeseen issue
			mState = HealthState.Error;
		}
		finally
		{
			// Sync shared health state with our findings.
			if (mState == HealthState.Ok)
				BackendHealth.MarkHealthy();
			else if (mState == HealthState.Error)
				BackendHealth.MarkUnhealthy();

			mIsChecking = false;
			StateHasChanged();
		}
	}

	/// <summary>
	/// Gets the CSS class suffix that represents the current health state.
	/// </summary>
	/// <returns>A CSS class name appended to the base class to style the indicator.</returns>
	private string GetDotClass() => mState switch
	{
		HealthState.Ok       => "lc-logo-health-dot-ok",
		HealthState.Error    => "lc-logo-health-dot-error",
		HealthState.Checking => "lc-logo-health-dot-checking",
		var _                => "lc-logo-health-dot-unknown"
	};

	/// <summary>
	/// Unsubscribes from health state events when the component is disposed.
	/// </summary>
	public void Dispose()
	{
		mIsDisposed = true;
		BackendHealth.OnHealthChanged -= OnHealthStateChanged;
	}
}
