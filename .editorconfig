# ===================================================
# Root configuration
# ===================================================
root = true

# ===================================================
# Universal editor settings
# ===================================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

# ===================================================
# Markdown files: preserve trailing spaces
# ===================================================
[*.md]
trim_trailing_whitespace = false

# ===================================================
# Windows scripts use CRLF
# ===================================================
[*.{bat,cmd,ps1,psm1,psd1}]
end_of_line = crlf

# ===================================================
# File-type specific overrides
# ===================================================
[*.json]
indent_style = space
indent_size = 2

[docs/api/*.json]
max_line_length = off

[*.{js,ts}]
quote_type = single

[*.{cs,csproj,vb,vbproj,fs,fsi,fsx,fsproj,props,targets,razor,cshtml}]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120

# ===================================================
# Code analysis: deliberate, repo-wide adjustments
# ===================================================
[*.cs]
# CA1805: "Do not initialize unnecessarily."
# Downgraded to suggestion because the analyzer is noisy for value types with non-trivial
# default constructors (e.g., HttpRequestMessage) where explicit initialization is common
# and intentional for readability, consistency, or to avoid subtle bugs (e.g., uninitialized
# fields in structs).
dotnet_diagnostic.CA1805.severity = suggestion

# CA1848: "For improved performance, use the LoggerMessage delegates."
# CA1873: "The argument may be expensive and unnecessary if logging is disabled."
# Kept as suggestion: the source-generated LoggerMessage pattern is preferred
# for hot logging paths, but a blanket migration is not warranted today.
# Suggestion keeps the hint visible in the IDE without polluting build output.
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

[*.{html,xml,xaml,js,css,sql,resx}]
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true

# ===================================================
# Test projects: xUnit v3 analyzer adjustments
# ===================================================
[{src/*.Tests/*.cs,src/*.Tests/**/*.cs}]
# xUnit1051: "Use TestContext.Current.CancellationToken for responsive test cancellation."
# Downgraded to suggestion because many tests intentionally control their CancellationToken
# (e.g., cancellation-behavior tests, timeout tests). The global safety net in
# xunit.runner.json (longRunningTestSeconds: 10) already catches runaway tests.
dotnet_diagnostic.xUnit1051.severity = suggestion

# xUnit2013: "Do not use equality check to check for collection size."
# Downgraded to suggestion because Assert.Equal(expectedCount, collection.Count) is
# preferred when tests verify a specific count alongside full element assertions —
# Assert.Single() only covers count == 1 and loses the explicit count context.
dotnet_diagnostic.xUnit2013.severity = suggestion

# CA1707: "Identifiers should not contain underscores."
# Disabled for test projects: the Method_Scenario_Expectation naming pattern is
# the de-facto xUnit standard and intentionally uses underscores for readability
# in test runners.
dotnet_diagnostic.CA1707.severity = none

# CA2263: "Prefer the generic overload."
# Tests for non-generic API surface (e.g. Register(string, Type)) intentionally
# call the non-generic overload to validate its behavior; flagging that is
# noise rather than signal.
dotnet_diagnostic.CA2263.severity = none
