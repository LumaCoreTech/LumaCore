<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<AssemblyName>LumaCore.Api</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<!--
	═══════════════════════════════════════════════════════════════════════════════
	BUILD-TIME OPENAPI DOCUMENT GENERATION
	═══════════════════════════════════════════════════════════════════════════════
	
	OpenAPI JSON generation is handled by the dedicated script:
	  ./build.net/OpenApi/generate-openapi-json.ps1
	
	The script generates one JSON file per API version (v1.json, v2.json, etc.)
	and handles Microsoft's quirky naming conventions correctly.
	
	DO NOT use /p:GenerateOpenApi=true directly - use the script instead.
	
	After JSON generation, run:
	  ./build.net/OpenApi/generate-api-docs.ps1
	to create Markdown documentation.
	
	See docs/api/README.md for full workflow documentation.
	═══════════════════════════════════════════════════════════════════════════════
	-->
	<!-- OpenAPI generation disabled by default - use generate-openapi-json.ps1 -->
	<PropertyGroup>
		<OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
	</PropertyGroup>

	<PropertyGroup>
		<!--
		Include Blazor UI via project reference (default: true).
		Set to false when building the API without UI, e.g. for Docker:
		  dotnet publish /p:IncludeBlazorUi=false
		-->
		<IncludeBlazorUi Condition="'$(IncludeBlazorUi)' == ''">true</IncludeBlazorUi>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\LumaCore.Api.Contracts\LumaCore.Api.Contracts.csproj" />
		<ProjectReference Include="..\LumaCore.Core\LumaCore.Core.csproj" />
		<ProjectReference Include="..\LumaCore.Ui.Web\LumaCore.Ui.Web.csproj" Condition="'$(IncludeBlazorUi)' == 'true'" />
	</ItemGroup>

	<ItemGroup>
		<!-- ASP.NET Core Packages -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.2" />

		<!-- API Versioning for Minimal APIs -->
		<PackageReference Include="Asp.Versioning.Http" Version="8.1.1" />

		<!-- API Explorer for versioned OpenAPI document generation -->
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />

		<!-- Native OpenAPI for .NET 10 -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />

		<!-- Build-time OpenAPI document generation -->
		<PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>

		<!-- Swagger UI (visualization only, OpenAPI generation is native) -->
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.0" />

		<!-- Serilog packages compatible with .NET 8+ -->
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
		<PackageReference Include="Serilog.Enrichers.Span" Version="3.1.0" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="logs\" />
	</ItemGroup>

</Project>
