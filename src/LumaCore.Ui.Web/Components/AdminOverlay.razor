@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

@*
	Admin Overlay Component - Desktop-first admin panel as modal overlay

	Features:
	- Opens as modal overlay on top of current page
	- Contains admin tools (Status, Dashboard, Settings, etc.)
	- ESC key to close
	- Click outside to close
	- Smooth animations
	- Theme-aware styling

	Usage:
	- Add to MainLayout
	- Show/hide via @ref and ShowAsync()/HideAsync()
*@

@if (mIsVisible)
{
	<div class="lc-admin-overlay" @onclick="HandleBackdropClick">
		<div class="lc-admin-panel" @onclick:stopPropagation="true">

			<header class="lc-admin-header">
				<h2>@Localizer["components.admin.header.title"]</h2>
				<button class="lc-admin-close" @onclick="HideAsync" title="@Localizer["components.admin.header.closeHint"]">
					<LcIcon Name="close"/>
				</button>
			</header>

			<nav class="lc-admin-tabs">
				<button class="lc-admin-tab @(mActiveTab == "status" ? "lc-admin-tab-active" : "")"
				        @onclick='() => SetActiveTab("status")'>
					<span>@Localizer["components.admin.tabs.status"]</span>
				</button>
				@* Future tabs can be added here:
				<button class="lc-admin-tab @(mActiveTab == "dashboard" ? "lc-admin-tab-active" : "")"
				        @onclick='() => SetActiveTab("dashboard")'>
					Dashboard
				</button>
				<button class="lc-admin-tab @(mActiveTab == "settings" ? "lc-admin-tab-active" : "")"
				        @onclick='() => SetActiveTab("settings")'>
					Settings
				</button>
				*@
			</nav>

			<main class="lc-admin-content lc-admin-mode">
				@if (mActiveTab == "status")
				{
					<StatusContent/>
				}
				@* Future tab content:
				else if (mActiveTab == "dashboard")
				{
					<DashboardContent />
				}
				*@
			</main>

		</div>
	</div>
}

@code {
	private bool                                 mIsVisible;
	private string                               mActiveTab = "status";
	private DotNetObjectReference<AdminOverlay>? mThisRef;
	private IJSObjectReference?                  mJsModule;

	/// <summary>
	/// Lifecycle: Initialize component - register ESC key handler once.
	/// </summary>
	/// <param name="firstRender">Indicates whether this is the first time the component has been rendered.</param>
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			try
			{
				mJsModule = await JsRuntime
					            .InvokeAsync<IJSObjectReference>("import", "./Components/AdminOverlay.razor.js")
					            .ConfigureAwait(true);
				mThisRef = DotNetObjectReference.Create(this);
				await mJsModule.InvokeVoidAsync("registerEscHandler", mThisRef).ConfigureAwait(true);
			}
			catch
			{
				// Silently handle JS interop failures
			}
		}
	}

	/// <summary>
	/// Shows the admin overlay with optional initial tab.
	/// </summary>
	/// <param name="initialTab">The tab to show initially (default: <c>status</c>).</param>
	public Task ShowAsync(string initialTab = "status")
	{
		mActiveTab = initialTab;
		mIsVisible = true;
		StateHasChanged();
		return Task.CompletedTask;
	}

	/// <summary>
	/// Hides the admin overlay.
	/// </summary>
	public Task HideAsync()
	{
		mIsVisible = false;
		StateHasChanged();
		return Task.CompletedTask;
	}

	/// <summary>
	/// Handles clicks on the backdrop (outside the panel).
	/// </summary>
	private Task HandleBackdropClick()
	{
		return HideAsync();
	}

	/// <summary>
	/// Sets the active tab.
	/// </summary>
	private void SetActiveTab(string tab)
	{
		mActiveTab = tab;
		StateHasChanged();
	}

	/// <summary>
	/// Called from JavaScript when ESC key is pressed.
	/// Only hides the overlay if it is currently visible.
	/// </summary>
	[JSInvokable]
	public Task OnEscapeKeyPressed()
	{
		if (!mIsVisible)
			return Task.CompletedTask;

		return HideAsync();
	}

	/// <summary>
	/// Cleanup on component disposal.
	/// </summary>
	public async ValueTask DisposeAsync()
	{
		if (mJsModule is not null)
		{
			try
			{
				await mJsModule.InvokeVoidAsync("unregisterEscHandler").ConfigureAwait(true);
				await mJsModule.DisposeAsync().ConfigureAwait(true);
			}
			catch
			{
				// Silently handle JS interop failures during disposal
			}
		}

		mThisRef?.Dispose();
	}

}
