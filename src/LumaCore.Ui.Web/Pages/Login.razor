@page "/login"
@inject AuthService                    AuthService
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager              Navigation

@* 
    Login page for the LumaCore Web UI.
    
    Provides a simple form to authenticate with username, password, and a "Remember Me" option.
    On successful login, the user is redirected to the home page and the authentication state is updated.
*@

<PageTitle>Login - LumaCore</PageTitle>

<div class="lc-login-container">
	<div class="lc-login-card">
		@* Header with logo and title *@
		<div class="lc-login-header">
			<img src="assets/branding/lumacore-logo.svg" alt="LumaCore Logo" class="lc-login-logo"/>
			<h1 class="lc-login-title">@L.Get("components.login.title")</h1>
			<p class="lc-login-subtitle">@L.Get("components.login.subtitle")</p>
		</div>

		@* Login form with localized validation *@
		<EditForm EditContext="@mEditContext" OnValidSubmit="HandleLoginAsync" class="lc-login-form">

			@* Username field *@
			<div class="lc-form-group">
				<label for="username">@L.Get("components.login.fields.username")</label>
				<InputText id="username"
				           @bind-Value="mLoginModel.Username"
				           class="lc-input"
				           placeholder="@L.Get("components.login.fields.usernamePlaceholder")"
				           autocomplete="username"
				           autofocus/>
				<ValidationMessage For="@(() => mLoginModel.Username)" class="lc-validation-error"/>
			</div>

			@* Password field *@
			<div class="lc-form-group">
				<label for="password">@L.Get("components.login.fields.password")</label>
				<InputText id="password"
				           @bind-Value="mLoginModel.Password"
				           type="password"
				           class="lc-input"
				           placeholder="@L.Get("components.login.fields.passwordPlaceholder")"
				           autocomplete="current-password"/>
				<ValidationMessage For="@(() => mLoginModel.Password)" class="lc-validation-error"/>
			</div>

			@* Remember Me checkbox *@
			<div class="lc-form-group lc-checkbox-group">
				<label class="lc-checkbox-label">
					<InputCheckbox @bind-Value="mLoginModel.RememberMe" class="lc-checkbox"/>
					<span>@L.Get("components.login.rememberMe")</span>
				</label>
			</div>

			@* Error message display *@
			@if (!string.IsNullOrEmpty(mErrorMessage))
			{
				<div class="lc-error-banner">
					<span>@mErrorMessage</span>
				</div>
			}

			@* Submit button *@
			<button type="submit" class="lc-button lc-button-primary" disabled="@mIsLoggingIn">
				@if (mIsLoggingIn)
				{
					<span>@L.Get("components.login.submitting")</span>
				}
				else
				{
					<span>@L.Get("components.login.submit")</span>
				}
			</button>
		</EditForm>

		@* Footer note *@
		<div class="lc-login-footer">
			<p class="lc-login-footer-text">@L.Get("components.login.footer")</p>
		</div>
	</div>
</div>

@code {

	/// <summary>
	/// Model for the login form.
	/// </summary>
	/// <remarks>
	/// Validation is handled manually via <see cref="ValidateForm"/> to support localized error messages.
	/// DataAnnotations cannot be used because their <c>ErrorMessage</c> must be a compile-time constant.
	/// </remarks>
	private sealed class LoginFormModel
	{
		public string Username   { get; set; } = string.Empty;
		public string Password   { get; set; } = string.Empty;
		public bool   RememberMe { get; set; }
	}

	private readonly LoginFormModel          mLoginModel = new();
	private          EditContext?            mEditContext;
	private          ValidationMessageStore? mValidationMessageStore;
	private          string?                 mErrorMessage;
	private          bool                    mIsLoggingIn;

	/// <summary>
	/// Lifecycle: Initialize EditContext with custom validation.
	/// </summary>
	protected override void OnInitialized()
	{
		mEditContext = new EditContext(mLoginModel);
		mValidationMessageStore = new ValidationMessageStore(mEditContext);

		// Hook into validation requests to provide localized messages
		mEditContext.OnValidationRequested += HandleValidationRequested;

		// Clear field errors when the user modifies a field
		mEditContext.OnFieldChanged += HandleFieldChanged;
	}

	/// <summary>
	/// Handles validation requests by validating all fields with localized error messages.
	/// </summary>
	private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
	{
		mValidationMessageStore?.Clear();
		ValidateForm();
	}

	/// <summary>
	/// Clears validation errors for a field when it changes, providing immediate feedback.
	/// </summary>
	private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
	{
		mValidationMessageStore?.Clear(e.FieldIdentifier);
		mEditContext?.NotifyValidationStateChanged();
	}

	/// <summary>
	/// Validates all form fields and adds localized error messages to the message store.
	/// </summary>
	/// <remarks>
	/// Login validation intentionally only checks for empty fields. Password constraints (length, complexity)
	/// are NOT enforced here because: (1) the backend validates credentials anyway, (2) policy changes
	/// would lock out users with legacy passwords, (3) it leaks password policy to attackers.
	/// Constraints belong in registration/password-change forms, not login.
	/// </remarks>
	private void ValidateForm()
	{
		// Username: just check not empty
		if (string.IsNullOrWhiteSpace(mLoginModel.Username))
		{
			mValidationMessageStore?.Add(() => mLoginModel.Username, L.Get("components.login.validation.usernameRequired"));
		}

		// Password: just check not empty — no length/complexity constraints on login!
		if (string.IsNullOrWhiteSpace(mLoginModel.Password))
		{
			mValidationMessageStore?.Add(() => mLoginModel.Password, L.Get("components.login.validation.passwordRequired"));
		}

		mEditContext?.NotifyValidationStateChanged();
	}

	/// <summary>
	/// Handles the login form submission.
	/// </summary>
	/// <remarks>
	/// Attempts to authenticate with the provided credentials. On success, updates the authentication state
	/// and redirects to the home page. On failure, displays an error message to the user.
	/// </remarks>
	private async Task HandleLoginAsync()
	{
		mIsLoggingIn = true;
		mErrorMessage = null;
		StateHasChanged();

		try
		{
			// Attempt to log in using the AuthService.
			LoginResult result = await AuthService
				                     .LoginAsync(mLoginModel.Username, mLoginModel.Password, mLoginModel.RememberMe)
				                     .ConfigureAwait(true);

			if (result.Success)
			{
				// Notify the authentication system that the user is now logged in.
				AuthStateProvider.NotifyStateChanged();

				// Redirect to home page.
				Navigation.NavigateTo("/");
			}
			else
			{
				// Display error message from the service or localized default.
				mErrorMessage = !string.IsNullOrEmpty(result.ErrorMessage)
					                ? result.ErrorMessage
					                : L.Get("components.login.toasts.error");
			}
		}
		finally
		{
			mIsLoggingIn = false;
			StateHasChanged();
		}
	}

}
