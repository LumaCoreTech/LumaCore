<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Project: LumaCore.TestUtilities
        Purpose: Shared helpers consumed by test projects across the solution (in-memory ILogger
                 capture, async wait helpers, etc.).
        Scope:   Test-only. Not packed, not referenced by production code.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>LumaCore.TestUtilities</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="xunit.v3.assert" />
    </ItemGroup>
</Project>
