<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<AssemblyName>LumaCore.HealthCheck</AssemblyName>
		<OutputType>Exe</OutputType>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Tool metadata -->
		<Description>Lightweight health check client for Docker HEALTHCHECK instructions. Returns exit code 0 for healthy, 1 for unhealthy.</Description>
	</PropertyGroup>

	<!--
	Note: This tool is framework-dependent (default) by design.
	The .NET runtime is already present in the Docker container (aspnet:10.0),
	so there's no need for SelfContained deployment. This keeps the tool at
	just a few KB instead of ~60-80MB with embedded runtime.
	-->

</Project>
