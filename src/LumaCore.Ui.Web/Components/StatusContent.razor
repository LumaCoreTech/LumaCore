@using System.Net
@using System.Text.Json
@inject HttpClient         Http
@inject BackendHealthState BackendHealth

@*
	StatusContent Component - Reusable status monitoring logic

	This component can be embedded in:
	- Admin Overlay (modal)
	- Standalone Status page
	- Future: Dashboard widgets

	Shows backend health check status and allows manual refresh.
*@

<div class="lc-status-content">
	<h2 class="lc-status-title">@L.Get("components.admin.status.title")</h2>

	@if (mIsLoading)
	{
		@* Initial and refresh state while the health check is running *@
		<p class="lc-status-message">@L.Get("components.admin.status.checking")</p>
	}
	else if (mError is not null)
	{
		@* Error state if the health endpoint cannot be reached or returns invalid data *@
		<p class="lc-status-badge lc-status-badge-error">@L.Get("components.admin.status.unreachable")</p>
		<p class="lc-status-detail">@mError</p>
	}
	else if (mStatus is not null)
	{
		@* Healthy state with the reported status text from the backend *@
		<p class="lc-status-badge lc-status-badge-ok">@L.Get("components.admin.status.reachable")</p>
		<p class="lc-status-detail">
			<span>@L.Get("components.admin.status.reportedLabel")</span> @mStatus
		</p>
	}
	else
	{
		@* Fallback in case no explicit status text was returned *@
		<p class="lc-status-badge">@L.Get("components.admin.status.unknown")</p>
		<p class="lc-status-detail">@L.Get("components.admin.status.unknownHint")</p>
	}

	<div class="lc-status-actions">
		<button class="lc-button lc-button-secondary" @onclick="OnRefreshAsync" disabled="@mIsLoading">
			@if (mIsLoading)
			{
				<span>@L.Get("components.admin.status.btnChecking")</span>
			}
			else
			{
				<span>@L.Get("components.admin.status.btnRecheck")</span>
			}
		</button>
	</div>
</div>

@code
{
	/// <summary>
	/// Indicates whether a health check request is currently in progress.
	/// </summary>
	private bool mIsLoading = true;

	/// <summary>
	/// Holds the last error message from a failed health check, if any.
	/// </summary>
	private string? mError;

	/// <summary>
	/// Holds the textual status reported by the backend, if available.
	/// </summary>
	private string? mStatus;

	/// <summary>
	/// Called by the Blazor framework when the component is first initialized.
	/// Triggers the initial backend health check.
	/// </summary>
	protected override Task OnInitializedAsync()
	{
		return LoadStatusAsync();
	}

	/// <summary>
	/// Handles clicks on the "Recheck backend health" button by re-running the health check workflow.
	/// </summary>
	private Task OnRefreshAsync()
	{
		return LoadStatusAsync();
	}

	/// <summary>
	/// Timeout for health check requests. Short timeout to avoid UI hanging on unresponsive backends.
	/// </summary>
	private static readonly TimeSpan HealthCheckTimeout = TimeSpan.FromSeconds(5);

	/// <summary>
	/// Calls the backend live health endpoint and updates the local status fields.
	/// </summary>
	/// <remarks>
	///     <para>
	///     Sends an HTTP GET request to the <c>api/v1/health/live</c> endpoint and distinguishes between:
	///     HTTP status failures, payload format issues, and a valid JSON response.
	///     </para>
	/// </remarks>
	private async Task LoadStatusAsync()
	{
		// Reset state for a fresh health check.
		mIsLoading = true;
		mError = null;
		mStatus = null;

		try
		{
			// Use a short timeout to avoid hanging on unresponsive backends.
			using var cts = new CancellationTokenSource(HealthCheckTimeout);

			// Perform a lightweight GET request and inspect the status code explicitly.
			using HttpResponseMessage response =
				await Http
					.GetAsync("api/v1/health/live", HttpCompletionOption.ResponseHeadersRead, cts.Token)
					.ConfigureAwait(true);

			if (!response.IsSuccessStatusCode)
			{
				mError = MapHttpError(response.StatusCode);
				return;
			}

			try
			{
				// Attempt to deserialize the JSON payload into the shared API contract.
				ApiHealthLiveResponse? dto = await response.Content
					                             .ReadFromJsonAsync<ApiHealthLiveResponse>(cts.Token)
					                             .ConfigureAwait(true);

				if (dto is null)
					mError = "Backend health endpoint returned an empty response.";
				else if (string.IsNullOrWhiteSpace(dto.Status))
					mError = "Backend health endpoint returned an empty status value.";
				else
					mStatus = dto.Status;
			}
			catch (JsonException)
			{
				mError = "Backend health endpoint returned data in an unexpected format.";
			}
		}
		catch (HttpRequestException ex)
		{
			mError = $"Could not reach backend health endpoint: {ex.Message}";
		}
		catch (Exception ex)
		{
			mError = $"Unexpected error while checking backend health: {ex.Message}";
		}
		finally
		{
			// Update shared health state based on the result.
			// This syncs the BackendHealthIndicator with our findings.
			if (mError is not null)
				BackendHealth.MarkUnhealthy();
			else if (mStatus is not null)
				BackendHealth.MarkHealthy();

			// Ensure the loading flag is reset so the UI can leave the "Checking…" state.
			mIsLoading = false;
			StateHasChanged();
		}
	}

	/// <summary>
	/// Maps a non-success HTTP status code from the backend health endpoint to a user-friendly error message.
	/// </summary>
	/// <param name="statusCode">The HTTP status code returned by the backend.</param>
	/// <returns>A short descriptive error message.</returns>
	private static string MapHttpError(HttpStatusCode statusCode)
	{
		int code = (int)statusCode;

		return statusCode switch
		{
			HttpStatusCode.NotFound           => "Backend health endpoint not found (HTTP 404).",
			HttpStatusCode.ServiceUnavailable => "Backend service unavailable (HTTP 503).",
			HttpStatusCode.Unauthorized       => "Backend requires authentication for the health endpoint (HTTP 401).",
			HttpStatusCode.Forbidden          => "Access to the backend health endpoint is forbidden (HTTP 403).",
			var _                             => $"Backend health endpoint returned HTTP {code} ({statusCode})."
		};
	}
}
