<Project>

	<!-- Optional: clean up /artifacts via 'dotnet clean /p:RemoveArtifacts=true' -->
	<Target Name="CleanArtifacts"
	        AfterTargets="Clean"
	        Condition="'$(RemoveArtifacts)' == 'true' and Exists('$(ArtifactsRoot)')">
		<Message Text="Removing $(ArtifactsRoot)" Importance="high" />
		<RemoveDir Directories="$(ArtifactsRoot)" />
	</Target>

	<!-- Optional: label publish outputs with semantic version -->
	<!-- Skip with /p:SkipArtifactNaming=true (e.g., in Docker builds) -->
	<Target Name="SetArtifactName" BeforeTargets="Publish" Condition="'$(SkipArtifactNaming)' != 'true'">
		<PropertyGroup>
			<_SemVer>$(NBGV_SemVer2)</_SemVer>
			<_Suffix Condition="'$(NBGV_IsPublicRelease)' != 'true'">-ci</_Suffix>
			<ArtifactName>$(MSBuildProjectName)-$(_SemVer)$(_Suffix)</ArtifactName>
			<PublishDir>$(ArtifactsRoot)bin\$(Configuration)\$(TargetFramework)\publish\$(ArtifactName)\</PublishDir>
		</PropertyGroup>
	</Target>

	<!-- Global Test Configuration -->
	<ItemGroup Condition="'$(IsTestProject)' == 'true'">
		<Content Include="$(MSBuildThisFileDirectory)xunit.runner.json"
		         CopyToOutputDirectory="PreserveNewest"
		         Visible="false" />
		<Content Include="$(MSBuildThisFileDirectory)coverlet.runsettings"
		         CopyToOutputDirectory="PreserveNewest"
		         Visible="false" />
	</ItemGroup>

	<!--
		Coverage report defaults for all test projects.
		Active only when coverage is collected via coverlet.msbuild
		(e.g. `dotnet test /p:CollectCoverage=true`).
	-->
	<PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(CollectCoverage)' == 'true'">
		<CoverletOutputFormat>cobertura</CoverletOutputFormat>
		<ExcludeByAttribute>DebuggerNonUserCode%2cGeneratedCodeAttribute%2cExcludeFromCodeCoverage</ExcludeByAttribute>
	</PropertyGroup>

</Project>
