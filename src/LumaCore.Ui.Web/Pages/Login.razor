@page "/login"
@using System.ComponentModel.DataAnnotations
@inject AuthService                       AuthService
@inject CookieAuthenticationStateProvider AuthStateProvider
@inject NavigationManager                 Navigation

@* 
    Login page for the LumaCore Web UI.
    
    Provides a simple form to authenticate with username, password, and a "Remember Me" option.
    On successful login, the user is redirected to the home page and the authentication state is updated.
*@

<PageTitle>Login - LumaCore</PageTitle>

<div class="lc-login-container">
	<div class="lc-login-card">
		@* Header with logo and title *@
		<div class="lc-login-header">
			<img src="assets/branding/lumacore-logo.svg" alt="LumaCore Logo" class="lc-login-logo"/>
			<h1 class="lc-login-title">@Localizer["components.login.title"]</h1>
			<p class="lc-login-subtitle">@Localizer["components.login.subtitle"]</p>
		</div>

		@* Login form with localized validation *@
		<EditForm Model="@mLoginModel" OnValidSubmit="HandleLoginAsync" class="lc-login-form">

			@* Use localized validation error messages *@
			<LocalizedDataAnnotationsValidator/>

			@* Username field *@
			<div class="lc-form-group">
				<label for="username">@Localizer["components.login.fields.username"]</label>
				<InputText id="username"
				           @bind-Value="mLoginModel.Username"
				           class="lc-input"
				           placeholder="@Localizer["components.login.fields.usernamePlaceholder"]"
				           autocomplete="username"
				           maxlength="@UiInputLimits.LoginUsernameMaxLength"
				           autofocus/>
				<ValidationMessage For="@(() => mLoginModel.Username)" class="lc-validation-error"/>
			</div>

			@* Password field *@
			<div class="lc-form-group">
				<label for="password">@Localizer["components.login.fields.password"]</label>
				<InputText id="password"
				           @bind-Value="mLoginModel.Password"
				           type="password"
				           class="lc-input"
				           placeholder="@Localizer["components.login.fields.passwordPlaceholder"]"
				           autocomplete="current-password"
				           maxlength="@UiInputLimits.LoginPasswordMaxLength"/>
				<ValidationMessage For="@(() => mLoginModel.Password)" class="lc-validation-error"/>
			</div>

			@* Remember Me checkbox *@
			<div class="lc-form-group lc-checkbox-group">
				<label class="lc-checkbox-label">
					<InputCheckbox @bind-Value="mLoginModel.RememberMe" class="lc-checkbox"/>
					<span>@Localizer["components.login.rememberMe"]</span>
				</label>
			</div>

			@* Error message display *@
			@if (!string.IsNullOrEmpty(mErrorMessage))
			{
				<div class="lc-error-banner">
					<span>@mErrorMessage</span>
				</div>
			}

			@* Submit button *@
			<button type="submit" class="lc-button lc-button-primary" disabled="@mIsLoggingIn">
				@if (mIsLoggingIn)
				{
					<span>@Localizer["components.login.submitting"]</span>
				}
				else
				{
					<span>@Localizer["components.login.submit"]</span>
				}
			</button>
		</EditForm>

		@* Footer note *@
		<div class="lc-login-footer">
			<p class="lc-login-footer-text">@Localizer["components.login.footer"]</p>
		</div>
	</div>
</div>

@code {

	/// <summary>
	/// Model for the login form.
	/// </summary>
	/// <remarks>
	/// Uses standard DataAnnotations with localized error messages. Blazor's validation system automatically resolves the
	/// ErrorMessage keys via IStringLocalizer.
	/// 
	/// Login validation intentionally only checks for empty fields. Password constraints (length, complexity) are NOT
	/// enforced here because:
	/// <list type="number">
	///     <item>
	///         <description>The backend validates credentials anyway.</description>
	///     </item>
	///     <item>
	///         <description>Policy changes would lock out users with legacy passwords.</description>
	///     </item>
	///     <item>
	///         <description>It leaks password policy to attackers.</description>
	///     </item>
	/// </list>
	/// Constraints belong in registration/password-change forms, not login.
	/// </remarks>
	private sealed class LoginFormModel
	{
		[Required(ErrorMessage = "components.login.validation.usernameRequired")]
		public string Username { get; set; } = string.Empty;

		[Required(ErrorMessage = "components.login.validation.passwordRequired")]
		public string Password { get; set; } = string.Empty;

		public bool RememberMe { get; set; }
	}

	private readonly LoginFormModel mLoginModel = new();
	private          string?        mErrorMessage;
	private          bool           mIsLoggingIn;

	/// <summary>
	/// Lifecycle: Component initialization.
	/// </summary>
	/// <remarks>
	/// DataAnnotationsValidator in the EditForm automatically handles validation using IStringLocalizer.
	/// No manual validation setup required!
	/// </remarks>
	protected override void OnInitialized()
	{
		// Nothing to do - DataAnnotationsValidator handles everything!
	}

	/// <summary>
	/// Handles the login form submission.
	/// </summary>
	/// <remarks>
	/// Attempts to authenticate with the provided credentials. On success, updates the authentication state
	/// and redirects to the home page. On failure, displays an error message to the user.
	/// </remarks>
	private async Task HandleLoginAsync()
	{
		mIsLoggingIn = true;
		mErrorMessage = null;
		StateHasChanged();

		try
		{
			// Attempt to log in using the AuthService.
			LoginResult result = await AuthService
				                     .LoginAsync(mLoginModel.Username, mLoginModel.Password, mLoginModel.RememberMe)
				                     .ConfigureAwait(true);

			if (result.Success)
			{
				// Notify the authentication system that the user is now logged in.
				AuthStateProvider.NotifyStateChanged();

				// Redirect to home page.
				Navigation.NavigateTo("/");
			}
			else
			{
				// Display error message from the service or localized default.
				mErrorMessage = !string.IsNullOrEmpty(result.ErrorMessage)
					                ? result.ErrorMessage
					                : Localizer["components.login.toasts.error"];
			}
		}
		finally
		{
			mIsLoggingIn = false;
			StateHasChanged();
		}
	}

}
