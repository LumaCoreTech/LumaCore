<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Project: LumaCore.TestUtilities
        Purpose: Shared helpers consumed by test projects across the solution. Examples include
                 in-memory ILogger capture (ListLogger), xUnit-flavored assertion helpers, and
                 common test doubles. Pragmatic over purist: since the entire repo standardizes
                 on xUnit, helpers may freely depend on xUnit primitives to keep the API ergonomic
                 (e.g. throwing XunitException instead of inventing a parallel exception type).
        Note:    References xunit.v3.extensibility.core (not xunit.v3) because xunit.v3 itself
                 requires the consuming project to be an executable test host (OutputType=Exe).
                 The extensibility.core package exposes the same Xunit.Sdk types we need without
                 that constraint.
        Scope:   Test-only. Not packed, not referenced by production code.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>LumaCore.TestUtilities</AssemblyName>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="xunit.v3.extensibility.core" />
    </ItemGroup>
</Project>
