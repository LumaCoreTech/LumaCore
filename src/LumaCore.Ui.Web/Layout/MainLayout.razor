@inherits LayoutComponentBase

@* 
    Main layout for the LumaCore Web UI preview.

    This layout defines:
    - A header with logo, backend health indicator, title, and navigation links.
    - A main content area where the current page is rendered via @Body.
    - A footer with a short tagline for the preview UI.
*@
<div class="lc-root">
	<header class="lc-header">
		<div class="lc-header-left">
			@* Logo block with the LumaCore logo and a live backend health indicator *@
			<div class="lc-logo-wrapper">
				<img src="assets/branding/lumacore-logo.svg"
				     alt="LumaCore Logo"
				     class="lc-logo-img"/>
				@* Small indicator that polls the backend and reflects its health state *@
				<BackendHealthIndicator/>
			</div>

			@* Title and subtitle describing the project vision *@
			<div class="lc-title-block">
				<div class="lc-title">LumaCore</div>
				<div class="lc-subtitle">
					A home for AI personas — built with warmth, intention, and the freedom to grow.
				</div>
			</div>
		</div>

		@* Primary navigation for the preview UI *@
		<nav class="lc-nav">
			@* Root/home entry; kept simple for the early preview version *@
			<a href="">Home</a>
			@* External link to the public project site, opened in a separate tab *@
			<a href="https://lumacore.tech" target="_blank" rel="noopener noreferrer">Project Site</a>

			@* Authentication-dependent navigation *@
			<AuthorizeView>
				<Authorized>
					@* Show Protected link and Logout button when authenticated *@
					<NavLink href="protected" class="...">Protected</NavLink>
					<button @onclick="HandleLogoutAsync" class="lc-nav-button">Logout</button>

					@* Settings Panel Toggle - Visible for all authenticated users *@
					<button class="lc-settings-toggle" @onclick="ShowSettingsPanelAsync" title="Settings">
						🎨
					</button>
				</Authorized>
				<NotAuthorized>
					@* Show Login link when not authenticated *@
					<NavLink href="login" class="...">Login</NavLink>
				</NotAuthorized>
			</AuthorizeView>

			@* Admin Panel Toggle - Only visible for admin role *@
			<AuthorizeView Roles="admin">
				<Authorized>
					<button class="lc-admin-toggle" @onclick="ShowAdminPanelAsync" title="Admin Panel">
						⚙️
					</button>
				</Authorized>
			</AuthorizeView>
		</nav>
	</header>

	@* Main area where the currently active page content is rendered *@
	<main class="lc-main">
		@Body
	</main>

	@* Footer with a short, stable tagline for the preview UI *@
	<footer class="lc-footer">
		<span>LumaCore UI (preview)</span>
		<span>Self-hosted. Persona-focused. Yours.</span>
	</footer>

	@* Settings Overlay - opens on demand via 🎨 button *@
	@if (mShowSettingsPanel)
	{
		<SettingsOverlay OnClose="HideSettingsPanelAsync"/>
	}

	@* Admin Overlay - opens on demand via ⚙️ button *@
	<AdminOverlay @ref="mAdminOverlay"/>
</div>

@code {

	[Inject]
	private AuthService? AuthService { get; set; }

	[Inject]
	private JwtAuthenticationStateProvider? AuthStateProvider { get; set; }

	[Inject]
	private NavigationManager? Navigation { get; set; }

	[Inject]
	private IJSRuntime? JsRuntime { get; set; }

	private AdminOverlay? mAdminOverlay;
	private bool          mShowSettingsPanel = false;

	/// <summary>
	/// Handles the logout action when the user clicks the logout button.
	/// </summary>
	/// <remarks>
	/// Clears the stored authentication token, notifies the authentication system of the state change,
	/// resets the theme to default, and redirects the user to the home page.
	/// </remarks>
	private async Task HandleLogoutAsync()
	{
		// Ensure all dependencies are available.
		// If any are missing, we cannot proceed with logout.
		// This is a safeguard against misconfiguration or runtime issues.
		if (AuthService is null || AuthStateProvider is null || Navigation is null || JsRuntime is null)
			return;

		// Reset theme to default before logout.
		// Failures in JS interop are silently handled to avoid disrupting the logout flow
		// (e.g., if JS is not available or the function is not defined).
		try
		{
			await JsRuntime.InvokeVoidAsync("resetThemeToDefault").ConfigureAwait(true);
		}
		catch
		{
			// Silently handle JS interop failures
		}

		// Perform logout via AuthService and notify the authentication state provider.
		// This will clear the auth token and update the UI accordingly.
		await AuthService.LogoutAsync().ConfigureAwait(true);
		AuthStateProvider.NotifyStateChanged();
		Navigation.NavigateTo("/");
	}

	/// <summary>
	/// Shows the settings panel overlay.
	/// </summary>
	private Task ShowSettingsPanelAsync()
	{
		mShowSettingsPanel = true;
		StateHasChanged();
		return Task.CompletedTask;
	}

	/// <summary>
	/// Hides the settings panel overlay.
	/// </summary>
	private Task HideSettingsPanelAsync()
	{
		mShowSettingsPanel = false;
		StateHasChanged();
		return Task.CompletedTask;
	}

	/// <summary>
	/// Shows the admin panel overlay.
	/// </summary>
	private async Task ShowAdminPanelAsync()
	{
		if (mAdminOverlay is not null)
		{
			await mAdminOverlay.ShowAsync().ConfigureAwait(true);
		}
	}

}
