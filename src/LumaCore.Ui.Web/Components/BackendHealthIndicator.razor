@using System.Text.Json
@implements IDisposable
@inject HttpClient         Http
@inject BackendHealthState BackendHealth

@* Clickable backend health indicator shown next to the logo in the main layout. *@
<div class="lc-logo-health-indicator"
     @onclick="OnClickAsync"
     title="@GetTooltip()">
	<span class="lc-logo-health-dot @GetDotClass()"></span>
</div>

@code
{
	/// <summary>
	/// Represents the current health state of the backend as observed by this component.
	/// </summary>
	private enum HealthState
	{
		Unknown,
		Checking,
		Ok,
		NotReady,
		Error
	}

	/// <summary>
	/// Holds the latest known backend health state; initialized to Unknown before the first probe runs.
	/// </summary>
	private HealthState mState = HealthState.Unknown;

	/// <summary>
	/// Guards against overlapping health checks (e.g., rapid clicks).
	/// </summary>
	private bool mIsChecking;

	/// <summary>
	/// Called by the Blazor framework when the component is first initialized.
	/// Subscribes to health state changes and triggers an initial health check.
	/// </summary>
	protected override Task OnInitializedAsync()
	{
		// Subscribe to passive health updates from API traffic.
		BackendHealth.OnHealthChanged += OnHealthStateChanged;

		// Sync initial state from shared state (may already be set from previous requests).
		mState = BackendHealth.IsHealthy    ? HealthState.Ok
		         : BackendHealth.IsNotReady ? HealthState.NotReady
		                                      : HealthState.Error;

		// Perform an active health check to verify the backend is reachable.
		return CheckHealthAsync();
	}

	/// <summary>
	/// Indicates whether the component has been disposed.
	/// </summary>
	private bool mIsDisposed;

	/// <summary>
	/// Handles health state changes from <see cref="BackendHealthState"/>.
	/// </summary>
	private void OnHealthStateChanged()
	{
		// Guard against events firing after disposal.
		if (mIsDisposed)
			return;

		mState = BackendHealth.IsHealthy    ? HealthState.Ok
		         : BackendHealth.IsNotReady ? HealthState.NotReady
		                                      : HealthState.Error;
		InvokeAsync(StateHasChanged);
	}

	/// <summary>
	/// Handles click events on the health indicator and re-runs the health check.
	/// </summary>
	private Task OnClickAsync()
	{
		return CheckHealthAsync();
	}

	/// <summary>
	/// Gets the localized tooltip for the current health state.
	/// </summary>
	/// <returns>The translated tooltip text.</returns>
	private string GetTooltip() => mState switch
	{
		HealthState.Ok       => Localizer["components.healthIndicator.tooltips.reachable"],
		HealthState.NotReady => Localizer["components.healthIndicator.tooltips.notReady"],
		HealthState.Error    => Localizer["components.healthIndicator.tooltips.unreachable"],
		HealthState.Checking => Localizer["components.healthIndicator.tooltips.checking"],
		var _                => Localizer["components.healthIndicator.tooltips.unknown"]
	};

	/// <summary>
	/// Timeout for health check requests. Short timeout to avoid UI hanging on unresponsive backends.
	/// </summary>
	private static readonly TimeSpan sHealthCheckTimeout = TimeSpan.FromSeconds(5);

	/// <summary>
	/// Checks the current health of the backend by calling the liveness and readiness endpoints.
	/// </summary>
	/// <remarks>
	/// Performs a two-step probe: first <c>/api/v1/health/live</c> to verify connectivity, then
	/// <c>/api/v1/health/ready</c> to check operational readiness. This produces three possible
	/// outcomes: <see cref="HealthState.Ok"/> (live + ready), <see cref="HealthState.NotReady"/>
	/// (live but not ready), or <see cref="HealthState.Error"/> (not reachable).
	/// </remarks>
	private async Task CheckHealthAsync()
	{
		// Prevent overlapping checks (e.g., rapid clicks).
		if (mIsChecking)
			return;

		mIsChecking = true;

		// Set state to "Checking" immediately so the UI can show a transitional state.
		mState = HealthState.Checking;
		StateHasChanged();

		try
		{
			// Use a short timeout to avoid hanging on unresponsive backends.
			using var cts = new CancellationTokenSource(sHealthCheckTimeout);

			// Step 1: Liveness — is the backend process reachable at all?
			if (!await IsLiveAsync(cts.Token).ConfigureAwait(true))
			{
				mState = HealthState.Error;
				return;
			}

			// Step 2: Readiness — is the backend ready to handle requests?
			mState = await IsReadyAsync(cts.Token).ConfigureAwait(true)
				         ? HealthState.Ok
				         : HealthState.NotReady;
		}
		catch (HttpRequestException)
		{
			// Network error — backend unreachable, DNS failure, connection refused, etc.
			mState = HealthState.Error;
		}
		catch
		{
			// Unexpected error — timeout, cancellation, or other unforeseen issue.
			mState = HealthState.Error;
		}
		finally
		{
			// Sync shared health state with our findings.
			switch (mState)
			{
				case HealthState.Ok:
					BackendHealth.MarkHealthy();
					break;

				case HealthState.NotReady:
					BackendHealth.MarkNotReady();
					break;

				default:
					BackendHealth.MarkUnhealthy();
					break;
			}

			mIsChecking = false;
			StateHasChanged();
		}
	}

	/// <summary>
	/// Checks whether the backend process is reachable by calling the liveness endpoint.
	/// </summary>
	/// <param name="cancellationToken">A token to cancel the operation.</param>
	/// <returns><see langword="true"/> if the backend returned a valid liveness response.</returns>
	private async Task<bool> IsLiveAsync(CancellationToken cancellationToken)
	{
		using HttpResponseMessage response = await Http
			                                     .GetAsync(
				                                     "api/v1/health/live",
				                                     HttpCompletionOption.ResponseHeadersRead,
				                                     cancellationToken)
			                                     .ConfigureAwait(true);

		if (!response.IsSuccessStatusCode)
			return false;

		try
		{
			ApiHealthLiveResponse? dto = await response.Content
				                             .ReadFromJsonAsync<ApiHealthLiveResponse>(cancellationToken)
				                             .ConfigureAwait(true);

			return dto is not null && !string.IsNullOrWhiteSpace(dto.Status);
		}
		catch (JsonException)
		{
			return false;
		}
	}

	/// <summary>
	/// Checks whether the backend is operationally ready by calling the readiness endpoint.
	/// </summary>
	/// <param name="cancellationToken">A token to cancel the operation.</param>
	/// <returns><see langword="true"/> if the backend reported a <c>"ready"</c> status.</returns>
	private async Task<bool> IsReadyAsync(CancellationToken cancellationToken)
	{
		using HttpResponseMessage response = await Http
			                                     .GetAsync(
				                                     "api/v1/health/ready",
				                                     HttpCompletionOption.ResponseHeadersRead,
				                                     cancellationToken)
			                                     .ConfigureAwait(true);

		// A 503 with valid JSON means "live but not ready" — any other non-2xx is an error,
		// but the caller already confirmed liveness, so we treat all non-success as "not ready".
		return response.IsSuccessStatusCode;
	}

	/// <summary>
	/// Gets the CSS class suffix that represents the current health state.
	/// </summary>
	/// <returns>A CSS class name appended to the base class to style the indicator.</returns>
	private string GetDotClass() => mState switch
	{
		HealthState.Ok       => "lc-logo-health-dot-ok",
		HealthState.NotReady => "lc-logo-health-dot-not-ready",
		HealthState.Error    => "lc-logo-health-dot-error",
		HealthState.Checking => "lc-logo-health-dot-checking",
		var _                => "lc-logo-health-dot-unknown"
	};

	/// <summary>
	/// Unsubscribes from health state events when the component is disposed.
	/// </summary>
	public void Dispose()
	{
		mIsDisposed = true;
		BackendHealth.OnHealthChanged -= OnHealthStateChanged;
	}
}
