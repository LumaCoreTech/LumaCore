{
  // ============================================================================
  // Development Overrides
  // ============================================================================
  // These settings override appsettings.json when ASPNETCORE_ENVIRONMENT=Development
  // ============================================================================
  "Serilog": {
    "MinimumLevel": {
      // More verbose logging in development
      "Default": "Debug"
    }
  },

  "Cors": {
    // Allow all origins in development for easy testing
    // NEVER use this configuration in production!
    "Enabled": true,
    "AllowedOrigins": ["*"],
    "AllowCredentials": false,
    "AllowedMethods": [],
    "AllowedHeaders": [],
    "ExposedHeaders": [],
    "PreflightMaxAge": 3600
  },

  "Jwt": {
    // DEV ONLY – do not reuse in production, replace with a long random value.
    "SigningKey": "DEV-ONLY-CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-STRING",

    // Short token lifetime for testing token expiration/refresh
    // "AccessTokenLifetimeMinutes": 60

    "Cookie": {
      // Allow cookies over plain HTTP in development (localhost without TLS).
      // NEVER set this to false in production!
      "SecureOnly": false
    }
  },

  "Database": {
    // DEV ONLY – do not reuse in production, replace with a long random value.
    "EncryptionKey": "DEV-ONLY-CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-STRING"
  }
}
