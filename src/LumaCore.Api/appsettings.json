{
    // ============================================================================
    // LumaCore API – Configuration
    // ----------------------------------------------------------------------------
    // Contains Kestrel tuning, Ollama model settings, and Serilog logging defaults.
    // All values can be overridden by environment-specific files or environment
    // variables (e.g., ASPNETCORE_ENVIRONMENT=Production).
    // ============================================================================

    "Kestrel": {
        "AddServerHeader": false,
        "Limits": {
            "KeepAliveTimeout": "00:05:00",
            "RequestHeadersTimeout": "00:00:15",
            "MaxRequestBodySize": 262144,
            "Http2": {
                "KeepAlivePingDelay": "00:00:30",
                "KeepAlivePingTimeout": "00:00:15"
            }
        },
        "Endpoints": {
            "Http": { "Url": "http://localhost:5080" }
        }
    },

    // ----------------------------------------------------------------------------
    // Serilog – structured logging configuration
    // ----------------------------------------------------------------------------
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File",
            "Serilog.Enrichers.Environment",
            "Serilog.Enrichers.Thread"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning",
                "Microsoft.Hosting.Lifetime": "Information"
            }
        },
        "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName", "WithEnvironmentName" ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext,-40} {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/lumacore-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "shared": true,
                    "outputTemplate": "{Timestamp:O} [{Level:u3}] {SourceContext} ({EnvironmentName}/{MachineName}/{ThreadId}) {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },

    "AllowedHosts": "*",

    // LumaCore app metadata (custom section)
    "LumaCore": {
        "Environment": "Development",
        "ApiVersion": "0.1",
        "EnableSwagger": true
    }
}
