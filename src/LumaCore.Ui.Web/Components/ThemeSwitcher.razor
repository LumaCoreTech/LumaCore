@* Theme Switcher - Select and preview themes *@
@inject IJSRuntime JsRuntime

<div class="lc-theme-switcher">

	<p class="lc-theme-description">
		Choose your theme - hover to preview!
	</p>

	<div class="lc-theme-grid">

		@* LumaCore Dark *@
		<div class="lc-theme-card @(mCurrentTheme == "lumacore-dark" ? "lc-theme-card-active" : "")"
		     @onmouseover="@(() => PreviewThemeAsync("lumacore-dark"))"
		     @onmouseout="ResetPreviewAsync"
		     @onclick="@(() => SelectThemeAsync("lumacore-dark"))">
			<div class="lc-theme-icon">🧡</div>
			<div class="lc-theme-name">LumaCore Dark</div>
			<div class="lc-theme-label">Default</div>
			<div class="lc-theme-preview lc-theme-preview-dark"></div>
			@if (mCurrentTheme == "lumacore-dark")
			{
				<div class="lc-theme-checkmark">✓</div>
			}
		</div>

		@* LumaCore Light *@
		<div class="lc-theme-card @(mCurrentTheme == "lumacore-light" ? "lc-theme-card-active" : "")"
		     @onmouseover="@(() => PreviewThemeAsync("lumacore-light"))"
		     @onmouseout="ResetPreviewAsync"
		     @onclick="@(() => SelectThemeAsync("lumacore-light"))">
			<div class="lc-theme-icon">🌟</div>
			<div class="lc-theme-name">LumaCore Light</div>
			<div class="lc-theme-label">Official</div>
			<div class="lc-theme-preview lc-theme-preview-light"></div>
			@if (mCurrentTheme == "lumacore-light")
			{
				<div class="lc-theme-checkmark">✓</div>
			}
		</div>

		@* Missi Pink *@
		<div class="lc-theme-card @(mCurrentTheme == "missi-pink" ? "lc-theme-card-active" : "")"
		     @onmouseover="@(() => PreviewThemeAsync("missi-pink"))"
		     @onmouseout="ResetPreviewAsync"
		     @onclick="@(() => SelectThemeAsync("missi-pink"))">
			<div class="lc-theme-icon">💜</div>
			<div class="lc-theme-name">Missi Pink</div>
			<div class="lc-theme-label">Community</div>
			<div class="lc-theme-preview lc-theme-preview-missi"></div>
			@if (mCurrentTheme == "missi-pink")
			{
				<div class="lc-theme-checkmark">✓</div>
			}
		</div>

		@* Ocean Blue *@
		<div class="lc-theme-card @(mCurrentTheme == "ocean-blue" ? "lc-theme-card-active" : "")"
		     @onmouseover="@(() => PreviewThemeAsync("ocean-blue"))"
		     @onmouseout="ResetPreviewAsync"
		     @onclick="@(() => SelectThemeAsync("ocean-blue"))">
			<div class="lc-theme-icon">💙</div>
			<div class="lc-theme-name">Ocean Blue</div>
			<div class="lc-theme-label">Community</div>
			<div class="lc-theme-preview lc-theme-preview-ocean"></div>
			@if (mCurrentTheme == "ocean-blue")
			{
				<div class="lc-theme-checkmark">✓</div>
			}
		</div>

		@* Forest Green *@
		<div class="lc-theme-card @(mCurrentTheme == "forest-green" ? "lc-theme-card-active" : "")"
		     @onmouseover="@(() => PreviewThemeAsync("forest-green"))"
		     @onmouseout="ResetPreviewAsync"
		     @onclick="@(() => SelectThemeAsync("forest-green"))">
			<div class="lc-theme-icon">💚</div>
			<div class="lc-theme-name">Forest Green</div>
			<div class="lc-theme-label">Community</div>
			<div class="lc-theme-preview lc-theme-preview-forest"></div>
			@if (mCurrentTheme == "forest-green")
			{
				<div class="lc-theme-checkmark">✓</div>
			}
		</div>

	</div>

	<p class="lc-theme-note">
		💡 Hover over a theme to preview it instantly!
	</p>

</div>

@code {

	/// <summary>
	/// Event callback invoked when the user selects a theme.
	/// </summary>
	[Parameter]
	public EventCallback OnThemeChanged { get; set; }

	/// <summary>
	/// Currently active theme name.
	/// </summary>
	private string mCurrentTheme = "lumacore-dark";

	/// <summary>
	/// Lifecycle: Load current theme from localStorage on init.
	/// </summary>
	protected override async Task OnInitializedAsync()
	{
		try
		{
			// Small delay to ensure JavaScript is ready.
			await Task.Delay(50);
			mCurrentTheme = await JsRuntime.InvokeAsync<string>("getTheme").ConfigureAwait(true);

			Console.WriteLine($"[ThemeSwitcher] Initialized with theme: {mCurrentTheme}");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[ThemeSwitcher] Error loading theme, using default: {ex.Message}");
			mCurrentTheme = "lumacore-dark"; // Fallback
		}
	}

	/// <summary>
	/// Preview a theme temporarily (on hover).
	/// </summary>
	/// <param name="themeName">The theme to preview.</param>
	private async Task PreviewThemeAsync(string themeName)
	{
		try
		{
			// Preview the selected theme.
			await JsRuntime.InvokeVoidAsync("previewTheme", themeName).ConfigureAwait(true);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[ThemeSwitcher] Error previewing theme: {ex.Message}");
		}
	}

	/// <summary>
	/// Reset preview back to current theme (on mouse leave).
	/// </summary>
	private async Task ResetPreviewAsync()
	{
		try
		{
			// Reset to the currently selected theme.
			await JsRuntime.InvokeVoidAsync("resetThemePreview").ConfigureAwait(true);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[ThemeSwitcher] Error resetting preview: {ex.Message}");
		}
	}

	/// <summary>
	/// Select and persist a theme (on click).
	/// </summary>
	/// <param name="themeName">The theme to select.</param>
	private async Task SelectThemeAsync(string themeName)
	{
		mCurrentTheme = themeName;

		try
		{
			// Persist the selected theme.
			await JsRuntime.InvokeVoidAsync("selectTheme", themeName).ConfigureAwait(true);

			// Notify parent component of the theme change.
			await OnThemeChanged.InvokeAsync().ConfigureAwait(true);
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[ThemeSwitcher] Error selecting theme: {ex.Message}");
		}
	}

}
