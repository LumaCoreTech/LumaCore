<Project>

	<!-- Repository root -->
	<PropertyGroup>
		<RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
	</PropertyGroup>

	<!-- Redirect all bin/obj output to /artifacts (official .NET 8+ feature) -->
	<PropertyGroup>
		<UseArtifactsOutput>true</UseArtifactsOutput>
		<ArtifactsRoot>$(RepoRoot)artifacts\</ArtifactsRoot>
		<ArtifactsPath>$(ArtifactsRoot)</ArtifactsPath>
	</PropertyGroup>

	<!-- Language & code style defaults (applied to all projects) -->
	<PropertyGroup>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latestMajor</LangVersion>

		<!-- Docs + debugging -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DebugType>portable</DebugType>
		<ContinuousIntegrationBuild>$(CI)</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- Assembly and repository metadata -->
	<PropertyGroup>
		<Company>LumaCoreTech</Company>
		<Product>LumaCore</Product>
		<Authors>LumaCoreTech</Authors>
		<RepositoryUrl>https://github.com/LumaCoreTech/LumaCore</RepositoryUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<!-- MinVer Configuration -->
	<PropertyGroup>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>ci</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>

	<!-- Central package management -->
	<ItemGroup>
		<!-- Automatic semantic versioning -->
		<PackageReference Include="MinVer" Version="6.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- SourceLink for GitHub -->
		<PackageReference
			Include="Microsoft.SourceLink.GitHub"
			Version="8.0.0"
			PrivateAssets="all" />
	</ItemGroup>

</Project>
