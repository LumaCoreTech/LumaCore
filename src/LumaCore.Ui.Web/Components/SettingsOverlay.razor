@* Settings Overlay - User Settings Modal *@
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div class="lc-settings-overlay" @onclick="CloseAsync">
	<div class="lc-settings-panel" @onclick:stopPropagation>

		@* Header with close button *@
		<div class="lc-settings-header">
			<h2 class="lc-settings-title">@Localizer["components.settings.header.title"]</h2>
			<button class="lc-settings-close" @onclick="CloseAsync" title="@Localizer["components.settings.header.closeHint"]">
				<LcIcon Name="close"/>
			</button>
		</div>

		@* Tab Navigation *@
		<div class="lc-settings-tabs">
			<button class="lc-settings-tab @(mActiveTab == "theme" ? "lc-settings-tab-active" : "")"
			        @onclick='() => SetActiveTab("theme")'>
				<span>@Localizer["components.settings.tabs.theme"]</span>
			</button>
			<button class="lc-settings-tab @(mActiveTab == "language" ? "lc-settings-tab-active" : "")"
			        @onclick='() => SetActiveTab("language")'>
				<span>@Localizer["components.settings.tabs.language"]</span>
			</button>
		</div>

		@* Content Area *@
		<div class="lc-settings-content">
			@if (mActiveTab == "theme")
			{
				<ThemeSelector OnThemeChanged="HandleThemeChangedAsync"/>
			}
			else if (mActiveTab == "language")
			{
				<LanguageSelector OnLanguageChanged="HandleLanguageChangedAsync"/>
			}
		</div>

	</div>
</div>

@code {

	/// <summary>
	/// Event callback invoked when the user requests to close the settings overlay.
	/// </summary>
	[Parameter]
	public EventCallback OnClose { get; set; }

	/// <summary>
	/// Currently active tab in the settings panel.
	/// </summary>
	private string mActiveTab = "theme";

	/// <summary>
	/// Reference to this component for JavaScript interop (ESC key handling).
	/// </summary>
	private DotNetObjectReference<SettingsOverlay>? mDotNetRef;

	/// <summary>
	/// Reference to the collocated JavaScript module.
	/// </summary>
	private IJSObjectReference? mJsModule;

	/// <summary>
	/// Lifecycle: Initialize component - register ESC key handler.
	/// </summary>
	/// <param name="firstRender">Indicates whether this is the first time the component has been rendered.</param>
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			try
			{
				mJsModule = await JsRuntime
					            .InvokeAsync<IJSObjectReference>("import", "./Components/SettingsOverlay.razor.js")
					            .ConfigureAwait(true);
				mDotNetRef = DotNetObjectReference.Create(this);
				await mJsModule.InvokeVoidAsync("registerEscHandler", mDotNetRef).ConfigureAwait(true);
			}
			catch
			{
				// Silently handle JS interop failures
			}
		}
	}

	/// <summary>
	/// Sets the active tab in the settings panel.
	/// </summary>
	/// <param name="tabName">The name of the tab to activate.</param>
	private void SetActiveTab(string tabName)
	{
		mActiveTab = tabName;
	}

	/// <summary>
	/// Handles theme change from the ThemeSwitcher component.
	/// </summary>
	private Task HandleThemeChangedAsync()
	{
		// Could trigger additional actions here (analytics, etc.)
		return Task.CompletedTask;
	}

	/// <summary>
	/// Handles language change from the LanguageSelector component.
	/// </summary>
	private Task HandleLanguageChangedAsync()
	{
		// Page will reload after language change
		return Task.CompletedTask;
	}

	/// <summary>
	/// Closes the settings overlay by invoking the OnClose callback.
	/// Resets any active theme preview before closing.
	/// </summary>
	private async Task CloseAsync()
	{
		// Reset theme preview if user was hovering
		try
		{
			await JsRuntime.InvokeVoidAsync("resetThemePreview").ConfigureAwait(true);
		}
		catch
		{
			// Silently handle JS interop failures
		}

		await OnClose.InvokeAsync().ConfigureAwait(true);
	}

	/// <summary>
	/// Called when ESC key is pressed (invoked from JavaScript).
	/// </summary>
	[JSInvokable]
	public async Task OnEscapeKeyPressed()
	{
		await CloseAsync().ConfigureAwait(true);
	}

	/// <summary>
	/// Lifecycle: Cleanup - unregister ESC key handler and dispose references.
	/// </summary>
	public async ValueTask DisposeAsync()
	{
		if (mJsModule is not null)
		{
			try
			{
				await mJsModule.InvokeVoidAsync("unregisterEscHandler").ConfigureAwait(true);
				await mJsModule.DisposeAsync().ConfigureAwait(true);
			}
			catch
			{
				// Silently handle JS interop failures during disposal
			}
		}

		mDotNetRef?.Dispose();
	}

}
