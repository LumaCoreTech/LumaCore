<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<!--
		Project: LumaCore.Ui.Web
		Purpose: Blazor WebAssembly UI.
		Scope: UI-only code, including localization.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
		<!--TODO: Enable fingerprinting for production builds. -->
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<TypeScriptLanguageVersion>ES2024</TypeScriptLanguageVersion>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Extensions.Localization" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LumaCore.Api.Contracts\LumaCore.Api.Contracts.csproj" />
		<ProjectReference Include="..\LumaCore.Definitions\LumaCore.Definitions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

</Project>
