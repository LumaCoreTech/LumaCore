<?xml version="1.0" encoding="utf-8"?>

<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>
                    <Format>cobertura</Format>
                    <Include>[LumaCore.Core]LumaCore.Core.Collections.Deque*,[LumaCore.Core]LumaCore.Core.Collections.CollectionHelpers*</Include>
                    <ExcludeByAttribute>DebuggerNonUserCode,GeneratedCodeAttribute,ExcludeFromCodeCoverage</ExcludeByAttribute>
                    <IncludeTestAssembly>false</IncludeTestAssembly>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>
