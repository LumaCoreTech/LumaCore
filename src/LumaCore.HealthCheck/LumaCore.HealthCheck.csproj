<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>LumaCore.HealthCheck</AssemblyName>
		<OutputType>Exe</OutputType>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Optimize for size: this is a tiny diagnostic tool -->
		<PublishTrimmed>false</PublishTrimmed>
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>false</SelfContained>

		<!-- Tool metadata -->
		<Description>Lightweight health check client for Docker HEALTHCHECK instructions. Returns exit code 0 for healthy, 1 for unhealthy.</Description>
	</PropertyGroup>

</Project>
