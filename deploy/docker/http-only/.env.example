# ==============================================================================
# LumaCore Environment Variables (HTTP-only)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Uses ASP.NET Core configuration syntax: Section__Key
# All settings from appsettings.json can be overridden here.
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------
# Development = verbose logging, Swagger enabled
# Production  = log level Warning, Swagger disabled
ASPNETCORE_ENVIRONMENT=Development

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
# Signing key (minimum 32 characters)
# Development: default below is fine
# Production:  generate with: openssl rand -base64 32
Jwt__SigningKey=development-secret-key-change-in-production-min-32-chars

# ------------------------------------------------------------------------------
# More Options
# ------------------------------------------------------------------------------
# Any setting from appsettings.json can be overridden here.
# Use the pattern: Section__Subsection__Key=Value
#
# Examples:
#   Logging__LogLevel__Default=Information
#   Jwt__ExpirationMinutes=120
#
# See docs/deployment/configuration.md for all available settings.
