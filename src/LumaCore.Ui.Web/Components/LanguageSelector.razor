@* Language Selector - Choose UI language *@

<div class="lc-language-selector">

	<p class="lc-language-description">@L.Get("components.settings.language.title")</p>

	<div class="lc-language-grid">
		@if (mAvailableLocales != null)
		{
			@foreach (LocalizationService.LocaleInfo locale in mAvailableLocales)
			{
				<div class="lc-language-card @(mCurrentLocale == locale.Code ? "lc-language-card-active" : "")"
				     @onclick="@(() => SelectLanguageAsync(locale.Code))">
					<div class="lc-language-flag">
						<img src="locales/@locale.Code/flag.svg" alt="@locale.NativeName"/>
					</div>
					<div class="lc-language-name">@locale.NativeName</div>
					@if (mCurrentLocale == locale.Code)
					{
						<div class="lc-language-checkmark">
							<LcIcon Name="checkmark"/>
						</div>
					}
				</div>
			}
		}
	</div>

	<p class="lc-language-hint">@L.Get("components.settings.language.hint")</p>
</div>

@code {

	/// <summary>
	/// Event callback invoked when the language changes.
	/// </summary>
	[Parameter]
	public EventCallback OnLanguageChanged { get; set; }

	/// <summary>
	/// Available locales loaded from manifest.
	/// </summary>
	private IReadOnlyList<LocalizationService.LocaleInfo>? mAvailableLocales;

	/// <summary>
	/// Currently active locale.
	/// </summary>
	private string mCurrentLocale = "en";

	/// <summary>
	/// Lifecycle: Load current locale and available locales on init.
	/// </summary>
	protected override async Task OnInitializedAsync()
	{
		try
		{
			mCurrentLocale = L.CurrentLocale;
			mAvailableLocales = await L.GetAvailableLocalesAsync().ConfigureAwait(true);
		}
		catch
		{
			mCurrentLocale = "en";
		}
	}

	/// <summary>
	/// Select and apply a new language.
	/// </summary>
	private async Task SelectLanguageAsync(string locale)
	{
		if (mCurrentLocale == locale)
			return;

		await L.SetLocaleAsync(locale).ConfigureAwait(true);
		await OnLanguageChanged.InvokeAsync().ConfigureAwait(true);
	}

}
