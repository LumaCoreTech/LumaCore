@using System.Net
@using System.Text.Json
@inject HttpClient Http

@* Clickable backend health indicator shown next to the logo in the main layout. *@
<div class="lc-logo-health-indicator"
     @onclick="OnClickAsync"
     title="@GetTooltip()">
    <span class="lc-logo-health-dot @GetDotClass()"></span>
</div>

@code
{
    /// <summary>
    /// Represents the current health state of the backend as observed by this component.
    /// </summary>
    private enum HealthState
    {
        Unknown,
        Checking,
        Ok,
        Error
    }

    // Holds the latest known backend health state; initialized to Unknown before the first probe runs.
    private HealthState mState = HealthState.Unknown;

    // Stores the last error message from a failed health check, if any.
    private string? mLastError;

    /// <summary>
    /// Called by the Blazor framework when the component is first initialized.
    /// Triggers an initial health check against the backend.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
    protected override Task OnInitializedAsync()
    {
        return CheckHealthAsync();
    }

    /// <summary>
    /// Handles click events on the health indicator and re-runs the health check.
    /// </summary>
    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
    private Task OnClickAsync()
    {
        return CheckHealthAsync();
    }

    /// <summary>
    /// Checks the current health of the backend by calling the live health endpoint.
    /// Updates the internal state and error message based on the response.
    /// </summary>
    /// <remarks>
    ///     <para>
    ///     Sends an HTTP GET request to the <c>api/health/live</c> endpoint. HTTP status codes and
    ///     payload format are handled separately:
    ///     </para>
    ///     <list type="bullet">
    ///         <item>
    ///             <description>Non-success status codes produce HTTP-specific error messages.</description>
    ///         </item>
    ///         <item>
    ///             <description>A successful status code with malformed JSON produces a format-related message.</description>
    ///         </item>
    ///         <item>
    ///             <description>A valid <see cref="HealthLiveDto"/> with a non-empty <c>Status</c> marks the backend as healthy.</description>
    ///         </item>
    ///     </list>
    /// </remarks>
    /// <returns>A <see cref="Task"/> representing the asynchronous operation.</returns>
    private async Task CheckHealthAsync()
    {
        // Set state to "Checking" immediately so the UI can show a transitional state.
        mState = HealthState.Checking;
        mLastError = null;
        StateHasChanged(); // Force a re-render so the user sees the checking state.

        try
        {
            // Perform a lightweight GET request and inspect the status code explicitly.
            using HttpResponseMessage response = await Http.GetAsync("api/health/live", HttpCompletionOption.ResponseHeadersRead);

            if (!response.IsSuccessStatusCode)
            {
                // Map non-success HTTP status codes to user-friendly messages.
                mState = HealthState.Error;
                mLastError = MapHttpError(response.StatusCode);
                StateHasChanged();
                return;
            }

            try
            {
                // Attempt to deserialize the JSON payload into the expected DTO.
                var dto = await response.Content.ReadFromJsonAsync<HealthLiveDto>();

                if (dto is null || string.IsNullOrWhiteSpace(dto.Status))
                {
                    mState = HealthState.Error;
                    mLastError = "Backend health endpoint returned an empty or incomplete response.";
                }
                else
                {
                    mState = HealthState.Ok;
                }
            }
            catch (JsonException)
            {
                // Backend replied, but the payload is not valid JSON as expected.
                mState = HealthState.Error;
                mLastError = "Backend health endpoint returned data in an unexpected format.";
            }
        }
        catch (HttpRequestException ex)
        {
            // Network- or connection-level issue when calling the backend.
            mState = HealthState.Error;
            mLastError = $"Could not reach backend health endpoint: {ex.Message}";
        }
        catch (Exception ex)
        {
            // Any other unexpected failure is also surfaced as an error.
            mState = HealthState.Error;
            mLastError = $"Unexpected error while checking backend health: {ex.Message}";
        }

        StateHasChanged(); // Re-render so the updated state and tooltip become visible.
    }

    /// <summary>
    /// Maps a non-success HTTP status code from the backend health endpoint
    /// to a user-friendly error message.
    /// </summary>
    /// <param name="statusCode">The HTTP status code returned by the backend.</param>
    /// <returns>A short descriptive error message.</returns>
    private static string MapHttpError(HttpStatusCode statusCode)
    {
        int code = (int)statusCode;

        return statusCode switch
        {
            HttpStatusCode.NotFound =>
                "Backend health endpoint not found (HTTP 404).",
            HttpStatusCode.ServiceUnavailable =>
                "Backend service unavailable (HTTP 503).",
            HttpStatusCode.Unauthorized =>
                "Backend requires authentication for the health endpoint (HTTP 401).",
            HttpStatusCode.Forbidden =>
                "Access to the backend health endpoint is forbidden (HTTP 403).",
            var _ =>
                $"Backend health endpoint returned HTTP {code} ({statusCode})."
        };
    }

    /// <summary>
    /// Gets the CSS class suffix that represents the current health state.
    /// </summary>
    /// <returns>
    /// A CSS class name that is appended to the base <c>lc-logo-health-dot</c> class to style the indicator.
    /// </returns>
    private string GetDotClass() => mState switch
    {
        HealthState.Ok       => "lc-logo-health-dot-ok",
        HealthState.Error    => "lc-logo-health-dot-error",
        HealthState.Checking => "lc-logo-health-dot-checking",
        var _                => "lc-logo-health-dot-unknown"
    };

    /// <summary>
    /// Gets the tooltip text that describes the current backend health state.
    /// </summary>
    /// <returns>A human-readable tooltip string suitable for the <c>title</c> attribute.</returns>
    private string GetTooltip() => mState switch
    {
        HealthState.Ok       => "Backend reachable. Click to recheck.",
        HealthState.Error    => $"Backend unreachable: {mLastError}",
        HealthState.Checking => "Checking backend health…",
        var _                => "Backend status unknown. Click to check."
    };

    /// <summary>
    /// Minimal DTO used to deserialize the backend live health response.
    /// </summary>
    private sealed class HealthLiveDto
    {
        /// <summary>
        /// Gets or sets the reported overall health status of the backend.
        /// </summary>
        public string? Status { get; set; }
    }
}
