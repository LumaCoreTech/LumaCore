{
    // ============================================================================
    // Production Overrides
    // ============================================================================
    // These settings override appsettings.json when ASPNETCORE_ENVIRONMENT=Production
    //
    // IMPORTANT: Sensitive values (JWT SigningKey, database passwords, etc.)
    // should be provided via environment variables, not this file!
    // ============================================================================
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    // Human-readable for docker logs
                    "outputTemplate": "{Timestamp:O} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"

                    // Alternative: JSON format for log aggregation (Elasticsearch, etc.)
                    // "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                }
            }

            // No file sink in production (use docker logs or log aggregation)
        ]
    },

    "LumaCore": {
        "Environment": "Production",
        "EnableSwagger": false
    }

    // ============================================================================
    // JWT SigningKey — MUST be provided via environment variable!
    // ============================================================================
    //   Jwt__SigningKey=<your-long-random-secret-min-32-chars>
    //
    // Generate one: openssl rand -base64 32
    // ============================================================================
}
