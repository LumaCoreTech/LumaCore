# ==============================================================================
# LumaCore Environment Variables (HTTPS via ACME)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Uses ASP.NET Core configuration syntax: Section__Key
# All settings from appsettings.json can be overridden here.
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain (required!)
# ------------------------------------------------------------------------------
# Your public domain name. Caddy uses this to obtain TLS certificates.
# For email notifications on certificate issues, edit the Caddyfile directly.
DOMAIN=lumacore.example.com

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------
# For public deployments, use Production
ASPNETCORE_ENVIRONMENT=Production

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
# Signing key (minimum 32 characters)
# Generate with: openssl rand -base64 32
Jwt__SigningKey=CHANGE-ME-generate-a-secure-key-with-openssl-rand

# ------------------------------------------------------------------------------
# More Options
# ------------------------------------------------------------------------------
# Any setting from appsettings.json can be overridden here.
# Use the pattern: Section__Subsection__Key=Value
#
# Examples:
#   Logging__LogLevel__Default=Warning
#   Jwt__ExpirationMinutes=120
#
# See docs/deployment/configuration.md for all available settings.
